<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Convrt must read dragged files anywhere on disk and watch global drag events,
	     so the App Sandbox stays OFF. No network entitlements: the app never goes online. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
